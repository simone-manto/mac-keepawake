#!/bin/bash
# keepawake-toggle — toggle "coperchio chiuso + batteria" con notifica ON/OFF.
# Legato al tasto F5 via Karabiner. Usa sudo SENZA password solo per i due
# comandi pmset autorizzati in /etc/sudoers.d/keepawake.
export PATH="/usr/bin:/bin:/usr/sbin:/sbin"

state=$(pmset -g | awk '/SleepDisabled/{print $2}')

notify() { # $1 = titolo, $2 = testo, $3 = suono
  osascript -e "display notification \"$2\" with title \"$1\" sound name \"$3\""
}

# Se la regola sudoers manca, sudo -n fallisce senza password: fermarsi subito
# e dire la verita', invece di mostrare una notifica ON/OFF che mente.
# Ritorna una stringa vuota se OK, altrimenti il messaggio d'errore.
set_sleep() { # $1 = 0|1
  sudo -n pmset -a disablesleep "$1" 2>/dev/null
}

if [ "${state:-0}" = "1" ]; then
  # attualmente ON -> spengo
  if ! set_sleep 0; then
    echo "KeepAwake: sudo pmset fallito. Verifica la regola in /etc/sudoers.d/keepawake" >&2
    notify "⚠️ KeepAwake ERRORE" "sudo pmset fallito: regola sudoers assente? Vedi terminale." "Sosumi"
    exit 1
  fi
  pkill -f "caffeinate -dimsu" 2>/dev/null || true
  notify "☕️ KeepAwake OFF" "Sonno normale ripristinato. Non chiudere il coperchio durante i job." "Bottle"
else
  # attualmente OFF -> accendo
  if ! set_sleep 1; then
    echo "KeepAwake: sudo pmset fallito. Verifica la regola in /etc/sudoers.d/keepawake" >&2
    notify "⚠️ KeepAwake ERRORE" "sudo pmset fallito: regola sudoers assente? Vedi terminale." "Sosumi"
    exit 1
  fi
  pkill -f "caffeinate -dimsu" 2>/dev/null || true
  nohup caffeinate -dimsu >/dev/null 2>&1 &
  notify "⚡️ KeepAwake ON" "Puoi chiudere il coperchio: i job continuano su batteria." "Hero"
fi
